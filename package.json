{
  "name": "water-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "node scripts/dev-all.js",
    "build": "vite build",
    "build:render": "npm install && npm --prefix backend install && npm run build",
    "start": "node backend/src/server.js",
    "start:prod": "NODE_ENV=production node backend/src/server.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:schema": "npm --prefix backend run db:schema",
    "db:seed": "npm --prefix backend run db:seed",
    "db:clear": "npm --prefix backend run db:clear",
    "db:verify": "npm --prefix backend run db:verify",
    "db:init:cloud": "npm --prefix backend run db:init:cloud",
    "test:backend": "npm --prefix backend run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "^2.0.1",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
